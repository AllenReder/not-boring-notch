    "Choose which service to use when sharing files from the shelf. Click the shelf button to select files, or drag files onto it to share immediately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählen Sie den zu verwendenden Dienst aus, wenn Dateien geteilt werden. Klicken Sie auf die Ablage-Taste, um Dateien auszuwählen oder ziehen Sie Dateien auf die Ablage, um sie sofort zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which service to use when sharing files from the shelf. Click the shelf button to select files, or drag files onto it to share immediately."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선반에서 파일을 공유할 때 사용할 서비스를 선택하세요. 선반 버튼을 클릭해 파일을 선택하거나, 파일을 끌어다 놓으면 바로 공유할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz usługę używaną podczas udostępniania plików z półki. Kliknij przycisk półki, aby wybrać pliki, lub przeciągnij pliki na niego, aby udostępnić natychmiast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择从暂存器分享文件时使用的服务。点按暂存器按钮即可选择文件，也可以直接把文件拖进去立刻分享。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez le service utilisé pour partager des fichiers depuis l'étagère. Cliquez sur l'étagère pour sélectionner des fichiers, ou déposez-y des fichiers pour les partager aussitôt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige el servicio que se usa al compartir archivos desde la bandeja. Haz clic en la bandeja para seleccionar archivos o arrástralos sobre ella para compartirlos al momento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli il servizio da usare quando condividi file dallo scaffale. Fai clic sullo scaffale per selezionare i file, oppure trascinaceli sopra per condividerli subito."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvol službu, která se použije při sdílení souborů z police. Klikni na polici pro výběr souborů, nebo na ni soubory přetáhni a sdílej je hned."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Raftan dosya paylaşırken kullanılacak servisi seç. Dosya seçmek için raf düğmesine tıkla veya dosyaları rafta sürükleyip hemen paylaş."
          }
        }
      }
    },
