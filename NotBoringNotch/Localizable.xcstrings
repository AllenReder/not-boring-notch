    "Any process running as you can read this. It keeps web pages and sandboxed apps out, which is what it is for." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以你的身份运行的所有进程都能读取它，这正是它挡住网页和沙盒应用的方式。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder Prozess, der als du läuft, kann sie lesen. Genau das hält Webseiten und sandboxed Apps draußen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout processus exécuté sous votre compte peut le lire. C'est ce qui empêche les pages web et les apps sandboxées d'y accéder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cualquier proceso que se ejecute como tú puede leerlo. Eso es justo lo que mantiene fuera a las páginas web y a las apps en sandbox."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qualsiasi processo eseguito come te può leggerlo. È proprio questo che tiene fuori le pagine web e le app in sandbox."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사용자 권한으로 실행되는 모든 프로세스가 이 값을 읽을 수 있습니다. 웹 페이지와 샌드박스 앱을 막는 방식이 바로 그것입니다."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přečíst ho může každý proces běžící pod tvým účtem. Právě to drží webové stránky a sandboxované aplikace mimo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odczytze go każdy proces uruchomiony z Twoimi uprawnieniami. Właśnie to trzyma z dala strony internetowe i aplikacje w piaskownicy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senin olarak çalışan her işlem bunu okuyabilir. Web sayfalarını ve korumalı alandaki uygulamaları dışarıda tutan da tam olarak budur."
          }
        }
      }
    },
